PORT=4000
# Local MongoDB, or your MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
# Use a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS, comma separated, e.g. https://my-notes.vercel.app
# Leave empty locally: any http://localhost:<port> origin is then allowed.
CORS_ORIGIN=
# Set to 1 when running behind one reverse proxy (Render), 0 locally
TRUST_PROXY=0

# Accounts created by `npm run seed` (local development only;
# use different passwords when seeding a public deployment)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
